<?php
$escape = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
$target = isset($target) ? (string) $target : '/';
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="refresh" content="0;url=<?php echo $escapeAttr($target); ?>">
    <title><?php echo $escape($this->translate('Completing sign-in...')); ?></title>
</head>
<body>
    <p><?php echo $escape($this->translate('Completing sign-in. If you are not redirected, ')); ?>
       <a href="<?php echo $escapeAttr($target); ?>"><?php echo $escape($this->translate('continue here.')); ?></a></p>
    <script>window.location.replace(<?php echo json_encode(
        $target,
        JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
    ); ?>);</script>
</body>
</html>
